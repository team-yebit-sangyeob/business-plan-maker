# 오케스트레이터 LLM 설정
# OPENAI_API_KEY는 필수 — 없으면 서버가 기동되지 않는다(mock/키리스 경로 없음).
OPENAI_API_KEY=
# 계정에서 잡히는 모델 ID로 교체. 기본 후보: gpt-5-mini / gpt-4o-mini / gpt-4.1-mini
BPM_LLM_MODEL=gpt-5-mini

# 리서치 클러스터 (웹 사실 검증)
# 검색 프로바이더: tavily(기본) | exa
RESEARCH_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# 리서치/RAG 에이전트가 쓰는 OpenAI 모델(Responses API). 미설정 시 gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini

# 회사 RAG 벡터DB 경로 (이름 변경된 로컬 데이터 vector_db_store/).
# repo 루트에서 실행하면 상대경로로 충분하다. 다른 CWD면 절대경로 권장.
DOCS_BASE_PATH=vector_db_store/documents
DIRECTORY_MAP_PATH=vector_db_store/documents_info.md
